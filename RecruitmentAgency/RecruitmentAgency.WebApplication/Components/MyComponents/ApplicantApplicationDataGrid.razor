@using Blazorise.DataGrid
@inject IRecruitAgencyApiWrapper RecruitAgencyApi

<Card>
    <CardHeader>
        <Row Class="justify-content-between">
            <Column ColumnSize="ColumnSize.IsAuto">
                <h4>Заявки соискателей</h4>
            </Column>
            <Column ColumnSize="ColumnSize.IsAuto">
                <Button Color="Color.Primary" Clicked="OpenCreateModal">
                    Создать
                </Button>
            </Column>
        </Row>
    </CardHeader>
    <CardBody>
        <DataGrid TItem="ApplicantApplicantDTO"
                  Data="ApplicantApplications"
                  Responsive
                  Striped>
            <DataGridColumns>
                <DataGridColumn Width="150px"
                                TItem="ApplicantApplicantDTO"
                                Field="@nameof(ApplicantApplicantDTO.Id)"
                                Caption="Действия">
                    <DisplayTemplate>
                        <Dropdown>
                            <DropdownToggle Color="Color.Primary">
                                Действия
                            </DropdownToggle>
                            <DropdownMenu>
                                <DropdownItem Clicked="() => OpenEditPageAsync(context)">
                                    Редактировать
                                </DropdownItem>
                                <DropdownItem Clicked="() => DeleteApplicantApplicationAsync(context)">
                                    Удалить
                                </DropdownItem>
                            </DropdownMenu>
                        </Dropdown>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantApplicantDTO"
                                Field="@nameof(ApplicantApplicantDTO.Id)"
                                Caption="Идентификатор заявки">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantApplicantDTO"
                                Field="@nameof(ApplicantApplicantDTO.SubmissionDate)"
                                Caption="Дата подачи">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantApplicantDTO" Caption="Соискатель">
                    <DisplayTemplate>
                        @context.ApplicantId
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantApplicantDTO" Caption="Должность">
                    <DisplayTemplate>
                        @context.PositionId
                    </DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

<ApplicantApplicationCreateModal @ref="ApplicantApplicationCreateModal" OnApplicantApplicationAdded="@HandleApplicantApplicationListChanged" />
<ApplicantApplicationUpdateModal @ref="ApplicantApplicationUpdateModal" ApplicantApplicationToUpdate="SelectedApplicantApplication" Id="SelectedId" OnApplicantApplicationUpdated="@HandleApplicantApplicationListChanged" />


@code {
    private IEnumerable<ApplicantApplicantDTO> ApplicantApplications { get; set; } = [];
    private int SelectedId { get; set; }
    private ApplicantApplicationCreateDTO? SelectedApplicantApplication { get; set; }
    private ApplicantApplicationCreateModal ApplicantApplicationCreateModal { get; set; } = new();
    private ApplicantApplicationUpdateModal ApplicantApplicationUpdateModal { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshApplicantApplicationsCollection();
        await base.OnInitializedAsync();
    }

    private async Task OpenEditPageAsync(ApplicantApplicantDTO context)
    {
        SelectedId = context.Id;
        SelectedApplicantApplication = new()
            {
                SubmissionDate = context.SubmissionDate,
                ApplicantId = context.ApplicantId,
                PositionId = context.PositionId
            };
        await ApplicantApplicationUpdateModal.Show();
    }

    private async Task DeleteApplicantApplicationAsync(ApplicantApplicantDTO context)
    {
        await RecruitAgencyApi.DeleteApplicantApplication(context.Id);
        await RefreshApplicantApplicationsCollection();
    }

    private async Task HandleApplicantApplicationListChanged()
    {
        await RefreshApplicantApplicationsCollection();
    }

    private async Task OpenCreateModal() => await ApplicantApplicationCreateModal.Show();


    private async Task RefreshApplicantApplicationsCollection() => ApplicantApplications = await RecruitAgencyApi.GetAllApplicantApplications();
}
