@inject IRecruitAgencyApiWrapper RecruitAgencyApi

<Modal @ref="ApplicantModal">
    <ModalContent Centered>
        <Form>
            <ModalHeader>
                <ModalTitle>Изменить соискателя</ModalTitle>
                <CloseButton Clicked="CloseApplicantModalAsync" />
            </ModalHeader>

            <ModalBody>
                <Field>
                    <FieldLabel>ФИО</FieldLabel>
                    @if (ApplicantToUpdate != null)
                    {
                        <TextEdit @bind-Text="ApplicantToUpdate.FullName" />
                    }
                </Field>
                <Field>
                    <FieldLabel>Телефон</FieldLabel>
                    @if (ApplicantToUpdate != null)
                    {
                        <TextEdit @bind-Text="ApplicantToUpdate.ContactInformation" />
                    }
                </Field>
                <Field>
                    <FieldLabel>Опыт работы</FieldLabel>
                    @if (ApplicantToUpdate != null)
                    {
                        <InputNumber @bind-Value="ApplicantToUpdate.Experience" />
                    }
                </Field>
                <Field>
                    <FieldLabel>Образование</FieldLabel>
                    @if (ApplicantToUpdate != null)
                    {
                        <TextEdit @bind-Text="ApplicantToUpdate.Education" />
                    }
                </Field>
                <Field>
                    <FieldLabel>Ожидаемый уровень зарплаты</FieldLabel>
                    @if (ApplicantToUpdate != null)
                    {
                        <InputNumber @bind-Value="ApplicantToUpdate.Salaries" />
                    }
                </Field>
            </ModalBody>

            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="CloseApplicantModalAsync">Отмена</Button>
                <Button Color="Color.Primary" Clicked="UpdateApplicantAsync">Изменить</Button>
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@code {
    [Parameter]
    public EventCallback OnApplicantUpdated { get; set; }
    [Parameter]
    public int Id { get; set; }
    [Parameter]
    public ApplicantCreateDTO? ApplicantToUpdate { get; set; }

    private Modal ApplicantModal { get; set; } = new();

    public async Task Show() => await ApplicantModal.Show();

    private async Task CloseApplicantModalAsync() => await ApplicantModal.Hide();

    private async Task UpdateApplicantAsync()
    {
        await RecruitAgencyApi.UpdateApplicant(Id, ApplicantToUpdate!);
        await ApplicantModal.Hide();
        await OnApplicantUpdated.InvokeAsync();
    }
}
