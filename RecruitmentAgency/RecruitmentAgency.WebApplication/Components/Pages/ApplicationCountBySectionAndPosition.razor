@page "/application-count-by-section-pos"
@using Blazorise.DataGrid
@inject IRecruitAgencyApiWrapper RecruitAgencyApi

<Card>
    <CardHeader>
        <Row Class="justify-content-between">
            <Column ColumnSize="ColumnSize.IsAuto">
                <h4>Информация о количестве заявок по каждому разделу и должности.</h4>
            </Column>
        </Row>
    </CardHeader>
    <CardBody>
        <DataGrid TItem="ApplicationStatisticsDTO"
                  Data="Applicants"
                  Responsive
                  Striped>
            <DataGridColumns>
                <DataGridColumn TItem="ApplicationStatisticsDTO"
                                Field="@nameof(ApplicationStatisticsDTO.Section)"
                                Caption="Раздел, к которому относится должность">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicationStatisticsDTO"
                                Field="@nameof(ApplicationStatisticsDTO.PositionName)"
                                Caption="Название должности">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicationStatisticsDTO"
                                Field="@nameof(ApplicationStatisticsDTO.EmployerApplicationsCount)"
                                Caption="Количество заявок от работодателей по данной должности">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicationStatisticsDTO"
                                Field="@nameof(ApplicationStatisticsDTO.ApplicantApplicationsCount)"
                                Caption="Количество заявок от соискателей по данной должности">
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>


@code {
    private IEnumerable<ApplicationStatisticsDTO> Applicants { get; set; } = [];
    private int employerApplicationId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Applicants = await RecruitAgencyApi.GetApplicationCountBySectionAndPositionAll();
        await base.OnInitializedAsync();
    }
}

