@inject IRecruitAgencyApiWrapper RecruitAgencyApi

<Modal @ref="EmployerApplicationModal">
    <Alert Color="Color.Danger" @bind-Visible="@IsAlertVisible">
        <AlertMessage>Список работодателей или должностей пуст!</AlertMessage>
    </Alert>
    <ModalContent Centered>
        <Form>
            <ModalHeader>
                <ModalTitle>Изменить заявку</ModalTitle>
                <CloseButton Clicked="CloseEmployerApplicationModalAsync" />
            </ModalHeader>

            <ModalBody>
                @if (EmployerApplicationToUpdate != null)
                {
                <Field>
                    <FieldLabel>Дата подачи</FieldLabel>
                    <InputDate @bind-Value="EmployerApplicationToUpdate.SubmissionDate" />
                </Field>
                    <Field>
                        <FieldLabel>Выберите работодателя</FieldLabel>
                        <Select TValue="int" @bind-SelectedValue="EmployerApplicationToUpdate!.EmployerId">
                            @if (Employers != null)
                            {
                                @foreach (var employer in Employers)
                                {
                                    <SelectItem Value="@employer.Id">@($"{employer.Id} | {employer.CompanyName} | {employer.ContactPersonName} | {employer.CompanyNumber}")</SelectItem>
                                }
                            }
                        </Select>
                    </Field>
                    <Field>
                        <FieldLabel>Выберите должность</FieldLabel>
                        <Select TValue="int" @bind-SelectedValue="EmployerApplicationToUpdate!.PositionId">
                            @if (Positions != null)
                            {
                                @foreach (var position in Positions)
                                {
                                    <SelectItem Value="@position.Id">@($"{position.Id} | {position.Section} | {position.PositionName}")</SelectItem>
                                }
                            }
                        </Select>
                    </Field>
                    <Field>
                        <FieldLabel>Требование</FieldLabel>
                        <TextEdit @bind-Text="EmployerApplicationToUpdate.Requirements" />
                    </Field>
                    <Field>
                        <FieldLabel>Предлагаемый уровень зарплаты</FieldLabel>
                        <InputNumber @bind-Value="EmployerApplicationToUpdate.OfferedSalary" />
                    </Field>
                }
            </ModalBody>

            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="CloseEmployerApplicationModalAsync">Отмена</Button>
                <Button Color="Color.Primary" Clicked="UpdateEmployerApplicationAsync">Изменить</Button>
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@code {
    [Parameter]
    public EventCallback OnEmployerApplicationUpdated { get; set; }
    [Parameter]
    public int Id { get; set; }
    [Parameter]
    public EmployerApplicationCreateDTO? EmployerApplicationToUpdate { get; set; }
    private IEnumerable<EmployerDTO>? Employers { get; set; }
    private IEnumerable<PositionDTO>? Positions { get; set; }
    private Modal EmployerApplicationModal { get; set; } = new();
    private bool IsAlertVisible { get; set; } = false;

    public async Task Show()
    {
        await LoadEmployersAsync();
        await LoadPositionsAsync();
        EmployerApplicationToUpdate!.SubmissionDate = DateTime.Now;
        await EmployerApplicationModal.Show();
    }

    private async Task CloseEmployerApplicationModalAsync()
    {
        IsAlertVisible = false;
        EmployerApplicationToUpdate = new();
        await EmployerApplicationModal.Hide();
    }

    private async Task UpdateEmployerApplicationAsync()
    {
        try
        {
            await RecruitAgencyApi.UpdateEmployerApplication(Id, EmployerApplicationToUpdate!);
            await CloseEmployerApplicationModalAsync();
            await OnEmployerApplicationUpdated.InvokeAsync();
        }
        catch
        {
            IsAlertVisible = true;
        }
    }

    private async Task LoadEmployersAsync()
    {
        Employers = await RecruitAgencyApi.GetAllEmployers();
        if (Employers.FirstOrDefault() is null)
        {
            EmployerApplicationToUpdate!.EmployerId = 0;
        }
        else
        {
            EmployerApplicationToUpdate!.EmployerId = Employers.FirstOrDefault()!.Id;
        }
    }

    private async Task LoadPositionsAsync()
    {
        Positions = await RecruitAgencyApi.GetAllPositions();
        if (Positions.FirstOrDefault() is null)
        {
            EmployerApplicationToUpdate!.PositionId = 0;
        }
        else
        {
            EmployerApplicationToUpdate!.PositionId = Positions.FirstOrDefault()!.Id;
        }
    }
}

