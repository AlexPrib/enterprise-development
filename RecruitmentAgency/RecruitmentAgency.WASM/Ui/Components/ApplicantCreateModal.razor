@inject IRecruitAgencyApiWrapper RecruitAgencyApi

<Modal @ref="ApplicantModal">
    <ModalContent Centered>
        <Form>
            <ModalHeader>
                <ModalTitle>Новый соискатель</ModalTitle>
                <CloseButton Clicked="CloseApplicantModalAsync" />
            </ModalHeader>

            <ModalBody>
                <Field>
                    <FieldLabel>ФИО</FieldLabel>
                    <TextEdit @bind-Text="NewApplicant.FullName" />
                </Field>
                <Field>
                    <FieldLabel>Телефон</FieldLabel>
                    <TextEdit @bind-Text="@NewApplicant.ContactInformation" />
                </Field>
                <Field>
                    <FieldLabel>Опыт</FieldLabel>
                    <InputNumber @bind-Value="@NewApplicant.Experience" />
                </Field>
                <Field>
                    <FieldLabel>Образование</FieldLabel>
                    <TextEdit @bind-Text="@NewApplicant.Education" />
                </Field>
                <Field>
                    <FieldLabel>Ожидаемый уровень зарплаты</FieldLabel>
                    <InputNumber @bind-Value="@NewApplicant.Salaries" />
                </Field>
            </ModalBody>

            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="CloseApplicantModalAsync">Отмена</Button>
                <Button Color="Color.Primary" Clicked="CreateApplicantAsync">Создать</Button>
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@code {
    [Parameter]
    public EventCallback OnApplicantAdded { get; set; }

    private Modal ApplicantModal { get; set; } = new();
    private ApplicantCreateDTO NewApplicant { get; set; } = new() { Salaries = 0, ContactInformation = "", Education = "", Experience = 0, FullName = "" };

    public async Task Show() => await ApplicantModal.Show();

    private async Task CloseApplicantModalAsync()
    {
        NewApplicant = new() { Salaries = 0, ContactInformation = "", Education = "", Experience = 0, FullName = "" };
        await ApplicantModal.Hide();
    }

    private async Task CreateApplicantAsync()
    {
        await RecruitAgencyApi.CreateApplicant(NewApplicant);
        NewApplicant = new() { Salaries = 0, ContactInformation = "", Education = "", Experience = 0, FullName = "" };
        await ApplicantModal.Hide();
        await OnApplicantAdded.InvokeAsync();
    }
}
