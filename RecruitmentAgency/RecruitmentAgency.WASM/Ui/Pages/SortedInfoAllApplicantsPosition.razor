@page "/sorted-info-all-applicants-pos"
@using Blazorise.DataGrid
@inject IRecruitAgencyApiWrapper RecruitAgencyApi


<Card>
    <CardHeader>
        <Row Class="justify-content-between">
            <Column ColumnSize="ColumnSize.IsAuto">
                <h4>Получает всех соискателей для указанной позиции, отсортированных по полному имени</h4>
            </Column>
        </Row>
    </CardHeader>
    <CardBody>
        <DataGrid TItem="ApplicantDTO"
                  Data="Applicants"
                  Responsive
                  Striped>
            <DataGridColumns>
                <DataGridColumn TItem="ApplicantDTO"
                                Field="@nameof(ApplicantDTO.Id)"
                                Caption="Идентификатор">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantDTO"
                                Field="@nameof(ApplicantDTO.FullName)"
                                Caption="ФИО">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantDTO"
                                Field="@nameof(ApplicantDTO.ContactInformation)"
                                Caption="Телефон">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantDTO"
                                Field="@nameof(ApplicantDTO.Experience)"
                                Caption="Опыт работы">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantDTO"
                                Field="@nameof(ApplicantDTO.Education)"
                                Caption="Образование">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantDTO"
                                Field="@nameof(ApplicantDTO.Salaries)"
                                Caption="Ожидаемый уровень зарплаты">
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

<Div>
    <label>Название должности:</label>
    <TextEdit @bind-Text="@positionName" />

    <Button Color="Color.Primary" Clicked="RefreshProductsCollection">Поиск</Button>
</Div>

@code {
    private IEnumerable<ApplicantDTO> Applicants { get; set; } = [];
    private string positionName { get; set; } = "";

    private async Task RefreshProductsCollection()
    {
        Applicants = await RecruitAgencyApi.GetAllApplicantsByPositionOrderedByFullName(positionName);
        await base.OnInitializedAsync();
    }
}


