@page "/applicants-for-employerapp"
@using Blazorise.DataGrid
@inject IRecruitAgencyApiWrapper RecruitAgencyApi

<Card>
    <CardHeader>
        <Row Class="justify-content-between">
            <Column ColumnSize="ColumnSize.IsAuto">
                <h4>Список соискателей для заявки работодателя</h4>
            </Column>
        </Row>
    </CardHeader>
    <CardBody>
        <DataGrid TItem="ApplicantsForEmployerApplicationDTO"
                  Data="Applicants"
                  Responsive
                  Striped>
            <DataGridColumns>
                <DataGridColumn TItem="ApplicantsForEmployerApplicationDTO"
                                Field="@nameof(ApplicantsForEmployerApplicationDTO.ApplicantId)"
                                Caption="Соискатель">
                </DataGridColumn>
                <DataGridColumn TItem="ApplicantsForEmployerApplicationDTO"
                                Field="@nameof(ApplicantsForEmployerApplicationDTO.EmployerAppId)"
                                Caption="Заявка работодателя">
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>

<Div>
    <label>Заявка:</label>
    <Select TValue="int" @bind-SelectedValue="employerApplicationId">
        @foreach (var application in EmployerIdApp)
        {
            <SelectItem Value="@application.Id">@($"{application.Id}")</SelectItem>
        }
    </Select>
    <Button Color="Color.Primary" Clicked="RefreshAppCollection">Поиск</Button>
</Div>

@code {
    private IEnumerable<ApplicantsForEmployerApplicationDTO> Applicants { get; set; } = [];
    private IEnumerable<EmployerApplicationDTO> EmployerIdApp { get; set; } = [];
    private int employerApplicationId { get; set; }

    private async Task RefreshAppCollection()
    {
        Applicants = await RecruitAgencyApi.GetApplicantsForEmployerApplication(employerApplicationId);
    }

    protected override async Task OnInitializedAsync()
    {
        EmployerIdApp = await RecruitAgencyApi.GetAllEmployerApplications();
        if (EmployerIdApp.FirstOrDefault() is null)
        {
            employerApplicationId = 0;
        }
        else
        {
            employerApplicationId = EmployerIdApp.FirstOrDefault()!.Id;
        }
        await base.OnInitializedAsync();
    }
}
